NODE_ENV=production
APP_ORIGIN=https://wifi.example.com
PUBLIC_API_URL=https://wifi.example.com
SESSION_DAYS=7
# Compose supplies HOST, PORT, TRUST_PROXY and authenticated MONGODB_URI.
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Wifex administrator
# Keep disabled until callbacks, payment verification and router expiry pass testing.
PAYMENT_MODE=disabled
PAYHERO_AUTH_TOKEN=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_SECRET=
ROUTER_MODE=live
ALLOW_ROUTER_HTTP=false
