PORT=4000
HOST=127.0.0.1
TRUST_PROXY=loopback
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/wifex?replicaSet=rs0
APP_ORIGIN=http://localhost:3000
SESSION_DAYS=7
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Network administrator
PAYMENT_MODE=disabled
# Copy the Basic Authorization token from Pay Hero > API Keys. Server-side only.
PAYHERO_AUTH_TOKEN=
PAYHERO_CHANNEL_ID=
PUBLIC_API_URL=https://wifi.example.com
PAYHERO_CALLBACK_SECRET=
ROUTER_MODE=live
ALLOW_ROUTER_HTTP=false

# Local launcher only (npm run start:local)
# MONGOD_PATH=C:/Program Files/MongoDB/Server/8.0/bin/mongod.exe
# WIFEX_LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/wifex?replicaSet=rs0
# Use this LAN origin for hotspot clients; omit for localhost only.
# WIFEX_LOCAL_ORIGIN=http://192.168.1.10:3001
