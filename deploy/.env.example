DOMAIN=wifi.example.com
# Use URL-safe random hex passwords, generated separately for each field.
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
# Leave empty for publicly trusted router management certificates.
# For your private CA: copy its public .crt to deploy/certs/wifex-ca.crt.
ROUTER_CA_FILE=
# ROUTER_CA_FILE=/app/certs/wifex-ca.crt
